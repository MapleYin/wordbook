# Project URL, and the "Publishable key" (older projects call this the "anon" key)
# from Settings -> API Keys. Never put the "Secret key" here — this app never needs
# it, since every query goes through RLS scoped to the signed-in user's session.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key

# DashScope (Qwen) API key from https://dashscope.console.aliyun.com
DASHSCOPE_API_KEY=your-dashscope-api-key
# Optional overrides — default model is qwen-plus, default base URL is the
# mainland China DashScope endpoint (use the -intl endpoint if your account is international)
QWEN_MODEL=qwen-plus
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
